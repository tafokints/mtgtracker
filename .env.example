# Either pair works. Vercel Redis/KV integrations often provide KV_* names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Owner-only login. Production requires all four values; no shared moderator accounts.
# Use a stable non-secret owner identifier, a random password (16+ chars), and secret (32+ chars).
ADMIN_OWNER_ID=
# Server-only despite the name. Never prefix with NEXT_PUBLIC_ or expose in next.config.
# Replaces ADMIN_PASSWORD; the old name is not accepted as a fallback.
ADMIN_PASSWORD_FRONTEND=
ADMIN_SESSION_SECRET=
# Enroll this 32+ character base32 seed in your authenticator before deployment.
ADMIN_TOTP_SECRET=

# Separate recovery-runner secret; not required by the website.
# Independently generated 32 random bytes, encoded as 64 hex characters.
BACKUP_ENCRYPTION_KEY=

# Connect a PRIVATE Vercel Blob store. On Vercel, the SDK manages rotating OIDC credentials.
BLOB_STORE_ID=
# Optional static-token alternative; required by the separate off-Vercel recovery runner.
# Never use a public store for intake or manually copy VERCEL_OIDC_TOKEN into settings.
BLOB_READ_WRITE_TOKEN=

# Required for public submissions. No production bypass. The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=mtgtrackers.com,www.mtgtrackers.com

# Both image scanners must pass before evidence can be previewed or published.
CLOUDMERSIVE_API_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Required to check/open submitted source links and approve source-linked reports.
GOOGLE_WEB_RISK_API_KEY=

NEXT_PUBLIC_SITE_URL=https://mtgtrackers.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
